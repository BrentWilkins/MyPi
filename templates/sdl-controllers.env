# SDL game controller mappings — sourced by the Openbox autostart before ES-DE.
# Multiple mappings go in one SDL_GAMECONTROLLERCONFIG value, separated by newlines.

# Fosmon Pro Controller clone (paired via Home+Y, handled by hid-generic)
# Physical->evtest: A=btn0, B=btn1, X=btn2, Y=btn3, L=btn4, R=btn5, ZL=btn6, ZR=btn7, -=btn8, +=btn9, Home=btn10
#
# DragonRise homemade arcade stick (vendor 0079 product 0006). SDL gives it the
# CRC-tagged GUID below and no built-in mapping, so ES-DE reported "no gamepads"
# until this entry existed. Both identical sticks share this GUID, so one mapping
# covers player 1 and player 2.
#   Buttons (SDL, 0-indexed): b0 = confirm/fire, b8 = Select (coin), b9 = Start
#   Lever: axes a0 (X) / a1 (Y) -> mapped to the d-pad for menu navigation
export SDL_GAMECONTROLLERCONFIG="030000007e0500090200000001000000,Pro Controller,a:b0,b:b1,x:b2,y:b3,leftshoulder:b4,rightshoulder:b5,lefttrigger:b6,righttrigger:b7,back:b8,start:b9,guide:b10,leftstick:b11,rightstick:b12,leftx:a0,lefty:a1,rightx:a2,righty:a3,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,
0300457e790000000600000010010000,DragonRise Arcade Stick,a:b0,b:b1,x:b2,y:b3,leftshoulder:b4,rightshoulder:b5,lefttrigger:b6,righttrigger:b7,back:b8,start:b9,dpup:-a1,dpdown:+a1,dpleft:-a0,dpright:+a0,platform:Linux,"
