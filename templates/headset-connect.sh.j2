#!/usr/bin/env bash
# Kick the trusted Bluetooth headset into connecting at session start.
#
# Cheap A2DP headsets often don't auto-connect on their own even when trusted,
# so retry for a minute. Exits 0 even if the headset is off/out of range so the
# systemd unit never shows as failed on a kiosk with no headset present.
#
# Deployed (templated) by playbooks/audio.yml to ~/.local/bin/headset-connect.sh
mac="{{ bt_headset_mac }}"

for _ in $(seq 1 12); do
  if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
    exit 0
  fi
  bluetoothctl connect "$mac" >/dev/null 2>&1 && exit 0
  sleep 5
done
exit 0
