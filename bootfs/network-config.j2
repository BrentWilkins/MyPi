network:
  version: 2
  ethernets:
    eth0:
      dhcp4: true
      dhcp6: true
      optional: true
  wifis:
    wlan0:
      dhcp4: false
      addresses:
        - 10.0.0.10/24
      routes:
        - to: default
          via: 10.0.0.1
      nameservers:
        addresses: [1.1.1.1, 1.0.0.1]
      regulatory-domain: "US"
      access-points:
        "{{ vault_wifi_ssid }}":
          password: "{{ vault_wifi_password_hash }}"
      optional: true
